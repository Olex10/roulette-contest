const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let key='';async function api(path,data){const r=await fetch('/api/admin/'+path,{method:data?'POST':'GET',headers:{'content-type':'application/json','x-admin-key':key},body:data?JSON.stringify(data):undefined});const x=await r.json();if(!r.ok)throw Error(x.error);return x}function msg(s){$('#msg').textContent=s}
async function load(){try{const x=await api('overview');$('#content').hidden=false;const labels={contact:'Контакт Telegram',cashiers:'Кассиры (JSON-массив объектов name,url)',prizes:'Призы (JSON-массив)',start_at:'Начало (ISO дата/время)',end_at:'Окончание (ISO дата/время)',contest_open:'Конкурс открыт (true/false)',final_open:'Финал открыт (true/false)',over_10000:'Свыше 10 000 ₽ (manual)'};$('#settings').innerHTML=Object.entries(labels).map(([k,l])=>`<form class="setting item" data-key="${k}"><label>${l}</label><textarea name="value" rows="2">${esc(x.settings[k])}</textarea><button>Сохранить</button></form>`).join('');document.querySelectorAll('.setting').forEach(f=>f.onsubmit=async e=>{e.preventDefault();try{await api('settings',{key:f.dataset.key,value:f.elements.value.value});msg('Настройка сохранена')}catch(err){msg(err.message)}});$('#requests').innerHTML=x.requests.map(r=>`<div class="item"><b>ID ${esc(r.player_id)}</b> · ${esc(r.status)} · ${esc(r.id)}<br><small>${esc(r.created_at)} ${r.amount?' · '+r.amount+' ₽':''} ${r.chips_awarded?' · '+r.chips_awarded+' фишек':''}</small>${r.status==='pending'?`<form class="decide" data-id="${esc(r.id)}"><label>Фактически подтверждённая сумма, ₽</label><input name="amount" type="number" min="1" step="1" required><label>Фишки вручную (только свыше 10 000 ₽)</label><input name="manual_chips" type="number" min="1" step="1"><div class="actions"><button name="decision" value="approved">Подтвердить</button><button class="secondary" name="decision" value="rejected">Отклонить</button></div></form>`:''}</div>`).join('')||'Заявок нет';document.querySelectorAll('.decide').forEach(f=>f.onsubmit=async e=>{e.preventDefault();const decision=e.submitter?.value;if(!confirm(decision==='approved'?'Подтвердить пополнение и начислить фишки?':'Отклонить заявку?'))return;try{await api('decide',{request_id:f.dataset.id,decision,amount:Number(f.elements.amount.value),manual_chips:Number(f.elements.manual_chips.value)});await load()}catch(err){msg(err.message)}});$('#players').innerHTML=x.players.map(p=>`<div class="item row"><span>ID ${esc(p.id)}</span><b>${p.chips} фишек</b></div>`).join('')||'Участников нет';$('#audit').innerHTML=x.audit.map(a=>`<div class="item">${esc(a.created_at)} · ${esc(a.action)} · ${esc(a.subject)}</div>`).join('')||'История пуста';msg('')}catch(e){msg(e.message)}}$('#enter').onclick=()=>{key=$('#key').value;$('#key').value='';load()};
